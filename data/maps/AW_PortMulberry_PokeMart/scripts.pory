mapscripts AW_PortMulberry_PokeMart_MapScripts {}

script AW_PortMulberry_PokeMart_Clerk {
    lock
    faceplayer
    message(gText_HowMayIServeYou)
	waitmessage
	pokemart(AW_PortMulberry_PokeMart_Mart)
	msgbox(gText_PleaseComeAgain)
	release
	end
}

mart AW_PortMulberry_PokeMart_Mart {
    ITEM_GREAT_BALL
	ITEM_SUPER_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_ESCAPE_ROPE
	ITEM_SUPER_REPEL
	ITEM_X_SP_ATK
	ITEM_X_SPEED
	ITEM_X_ATTACK
	ITEM_X_DEFENSE
	ITEM_DIRE_HIT
	ITEM_GUARD_SPEC
}