movement CarlaLeaveLab {
    walk_up*3
    face_left
}

movement AveryGotoMons1 {
    walk_left
    walk_down*2
    face_player
}

movement AveryGotoMons2 {
    walk_down
    walk_left*2
}

movement PlayerGotoMons {
    walk_left*3
    walk_down*3
    walk_left*3
}

movement CarlaGotoMons {
    walk_left*4
    walk_down*4
    walk_left*2 
}

movement EmoteHeart {
    emote_heart
}

movement MoveLeft1 {
    walk_left
}