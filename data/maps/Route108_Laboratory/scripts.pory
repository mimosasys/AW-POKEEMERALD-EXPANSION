script Route108_Laboratory_Yay {
    msgbox(format(
        "Would you like to give your Pokémon a nickname?"
    ), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        call(Common_EventScript_NameReceivedPartyMon)
    }
    waitstate
    //setflag(FLAG_ADVENTURE_STARTED) POKEDEX??
    setvar(VAR_AW_PROGRESS_1,4)
    message(format(
        "Fern: Well, that's that!"
    ))
    waitmessage
    message(format(
        "Carla: And what a cute Pokémon you chose!"
    ))
    waitmessage
    message(format(
        "Fern: Ok, now! Follow me outside, I'll show you around the place."
    ))
    waitmessage
    applymovement(1,ProfessorLeave)
    waitmovement(0)
    playse(SE_DOOR)
    removeobject(2)
    delay(60)
    release
}

script Route108_Laboratory_TalkCarla {
    lock
    applymovement(0,FacePlayer)
    if (var(VAR_AW_PROGRESS_1) == 3) {
        message(format(
            "Carla: Go on! Make a choice! They're all wonderful creatures."
        ))
        waitmessage
    } else {
        if (var(VAR_AW_PROGRESS_1) == 4) {
            message(format(
                "Carla: Go on, Professor Fern is waiting for you! Let's go!"
            ))
            waitmessage
        } else {
            message(format(
                "Carla: What's up, {PLAYER}? I'm just doing my research, as usual."
            ))
            waitmessage
        }
    }
    applymovement(0,FaceOriginalDirection)
    release
}

movement Route108_ProfessorEnter {
    walk_down
    walk_left*5
    walk_down*5
    walk_right*4
    face_left
}

movement WalkLeftSpot {
    walk_in_place_left*2
}

movement WalkRightSpot {
    walk_in_place_right*2
}

movement LookDown {
    face_down
}

movement LookUp {
    face_up
}

movement LookLeft {
    face_left
}

movement ProfessorToPokeballs {
    walk_left*5
    walk_down*6
    walk_left*11
    face_up
}

movement CarlaToPokeballs {
    walk_left*6
    walk_down*8
    walk_left*10
}

movement PlayerToPokeballs {
    walk_left*1
    walk_down*1
    walk_left*7
    walk_down*5
    walk_left*10
}

movement Player_WalkLeft {
    walk_left
}

movement ProfessorLeave {
    walk_down*2
}