mapscripts Route108_Laboratory_MapScripts {
    MAP_SCRIPT_ON_LOAD {
        if (var(VAR_AW_PROGRESS_1) == 3) {
            special(StopMapMusic)
            call(Route108_Laboratory_FirstTime)
        }
    }
}

script Route108_Laboratory_FirstTime {
    lockall
    applymovement(0,EmoteExclamation)
    waitmessage
    message(format(
        "???: Professor! Professor! They're awake!"
        ))
    waitmessage
    delay(20)
    playbgm(AW_MUS_LABORATORY,FALSE)
    applymovement(1,Route108_ProfessorEnter)
    waitmessage
    message(format(
        "???: Oh, I'm so glad you're alright.\p"
        "You fell from up on Mt. Eigo. How'd you even get up there, anyway?"
        ))
    waitmessage
    applymovement(1,EmoteExclamation)
    message(format(
        "Y- you say you live up there?! That can't be right! Nobody lives up there!"
    ))
    waitmessage
    applymovement(0,WalkLeftSpot)
    waitmovement(0)
    message(format(
        "???: Professor...?"
    ))
    waitmessage
    delay(30)
    applymovement(1,LookDown)
    delay(120)
    message(format(
        "???: Hmm... Well, I've been wrong before..."
    ))
    delay(120)
    applymovement(1,FacePlayer)
    message(format(
        "A- anyway..! I suppose I should introduce myself.\p"
        "My name is Avery Fern. I'm a professor of archaeology, and this is my lab."
    ))
    waitmessage
    delay(30)
    applymovement(1,LookUp)
    waitmovement(0)
    delay(10)
    message(format(
        "And this is my assistant, Carla."
    ))
    waitmessage
    applymovement(0,WalkRightSpot)
    waitmovement(0)
    message(format(
        "Carla: Hi."
    ))
    waitmovement(0)
    delay(10)
    message(format(
        "Fern: And you are?"
    ))
    waitmovement(0)
    delay(60)
    message(format(
        "Ah, {PLAYER}. Well, you are something of an enigma, that's for sure. It's lovely to make your acquaintaince.\p"
        "I think you should stay here a while, just to make sure you recover properly. Vibrava caught you, but I can't say whether or not you were hurt on the way down."
    ))
    waitmessage
    delay(10)
    applymovement(0,LookLeft)
    waitmovement(0)
    message(format(
        "Carla: Yeah! We can show {PLAYER} around the lab."
    ))
    waitmessage
    message(format(
        "Fern: You don't have a Pokémon, do you? We should probably do something about that.\n"
        "Here, come with me."
    ))
    waitmessage
    applymovement(0,ProfessorToPokeballs)
    applymovement(1,CarlaToPokeballs)
    applymovement(OBJ_EVENT_ID_PLAYER,PlayerToPokeballs)
    waitmovement(0)
    message(format(
        "Fern: Sorry, it's a bit of a mess. Here they are!\nTake your pick."
    ))
    waitmessage
    releaseall
}

script Route108_Laboratory_DontLeaveLeft {
    lock
    applymovement(0,WalkLeftSpot)
    waitmovement(0)
    delay(20)
    message(format(
        "Carla: Go on! Choose one!"
    ))
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER,Player_WalkLeft)
    release
}

script Route108_Laboratory_DontLeaveRight {
    lock
    applymovement(0,WalkLeftSpot)
    waitmovement(0)
    delay(20)
    message(format(
        "Carla: Go on! Choose one!"
    ))
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER,Player_WalkUp)
    release
}

script Route108_Laboratory_PickAlpacoil {
    lock
    if (var(VAR_AW_PROGRESS_1) == 3) {
        showmonpic(SPECIES_ALPACOIL,10,3)
        msgbox(format(
            "This is Alpacoil, the Steel Wool Pokémon!\p"
            "Would you like to take Alpacoil?"
        ), MSGBOX_YESNO)
        if (var(VAR_RESULT) == 1) {
            playmoncry(SPECIES_ALPACOIL,CRY_MODE_NORMAL)
            givemon(SPECIES_ALPACOIL,5)
            waitmoncry
            playfanfare(MUS_OBTAIN_ITEM)
            waitfanfare
            removeobject(3)
            call(Route108_Laboratory_Yay)
        } else {
            hidemonpic
            release
        }
    } else {
        message(format("It's one of the Professor's Pokémon."))
        waitmessage
        release
    }
}

