mapscripts AW_Route108_Lower_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Route108_HideOrShowTruck
    MAP_SCRIPT_ON_FRAME_TABLE [
        //VAR_AW_PROGRESS_1, 4: Route108_HideOrShowTruck
        //VAR_AW_PROGRESS_1, 5: Route108_HideOrShowTruck
    ]
}

script Route108_HideOrShowTruck {
    if (flag(FLAG_AW_HELP_GEAR) == FALSE) {
        setmetatile(8,38,0x1D8,TRUE)
        setmetatile(8,39,0x1D8,TRUE)
        setmetatile(9,38,0x1D9,TRUE)
        setmetatile(10,38,0x1D2,TRUE)
        setmetatile(10,39,0x1E2,TRUE)
        releaseall
    }
}

script Route108_YouCantParkThere {
    lockall
    if (flag(FLAG_AW_VISIT_MULBERRY) == false) {
        applymovement(9,WalkLeftSpot)
        waitmovement(0)
        message(format(
            "Hey! You can't just park your truck there!\p"
        ))
        waitmessage
        closemessage
        applymovement(8,WalkRightSpot)
        waitmovement(0)
        message(format(
            "Uh, yes I can. It's my truck.\p"
        ))
        waitmessage
        closemessage
        applymovement(9,FacePlayer)
        delay(10)
        message(format(
            "But people can't get past! Like this kid, for example.\p"
        ))
        waitmessage
        closemessage
        applymovement(8,WalkRightSpot)
        waitmovement(0)
        message(format(
            "Well, it sucks to be them.\p"
        ))
        applymovement(8,WalkLeftSpot)
        waitmovement(0)
        message(format(
            "...How did you even get it there?\p"
        ))
        waitmessage
        applymovement(8,FaceOriginalDirection)
        applymovement(9,FaceOriginalDirection)
        closemessage
    } else {
        applymovement(9,FacePlayer)
        message(format(
            "Well, lucky for you, there's nothing in the way, finally.\p"
            "What a doofus, parking your truck in the way like that.\p"
            "How'd he even get it here?"
        ))
        waitmessage
        applymovement(9,FaceOriginalDirection)
    }
    releaseall
}

script Route108_DidYouKnow {
    lockall
    applymovement(5,FacePlayer)
    waitmovement(0)
    message(format(
        "Did you know? Route 108 continues up here!\p"
        "Well, I say that, the gate here's closed.\p"
        "Huh? No, I've got no idea why. Strange, isn't it?\p"
    ))
    waitmessage
    releaseall
}

script Route108_YoullMeetTrainers {
    lockall
    applymovement(4,FacePlayer)
    waitmovement(0)
    message(format(
        "If you go on a journey with your Pokémon, you'll see plenty of trainers around the place wanting to battle!\p"
        "Huh? Me? I'm just out for a walk.\p"
    ))
    waitmessage
    releaseall
}

script Route108_SignLab {
    lock
    msgbox(format(
        "{UP_ARROW_2} TOPAZ LABORATORY"),MSGBOX_SIGN)
    waitmessage
    release
}

script Route108_SignToMulberry {
    lock
    msgbox(format(
        "{RIGHT_ARROW_2} PORT MULBERRY\n"
        "{LEFT_ARROW_2} ROUTE 108 (South)\n"
        "{DOWN_ARROW_2} PUCE CITY\n"
        "{UP_ARROW_2} ROUTE 108 (North)\n"
        ),MSGBOX_SIGN)
    waitmessage
    release
}

script Route108_SignToPuce {
    lock
    msgbox(format(
        "{DOWN_ARROW_2} PUCE CITY\n"
        "{UP_ARROW_2} ROUTE 108\n"
        "{RIGHT_ARROW_2} PORT MULBERRY\n"
        ),MSGBOX_SIGN)
    waitmessage
    release
}

script Route108_SignToNorth {
    lock
    msgbox(format(
        "{UP_ARROW_2} ROUTE 108 (North)\n"
        ),MSGBOX_SIGN)
    waitmessage
    release
}

movement WalkUpSpot {
    walk_in_place_up*2
}

movement FaceRight {
    face_right
}

movement LookDown {
    face_down
}

movement Camera_LookLeft3 {
    walk_left*6
}

movement Camera_LookRight3 {
    walk_right*6
}

movement MoveDown1 {
    walk_down
}

movement Camera_LookDown3 {
    walk_down*3
}

movement Camera_LookUp3 {
    walk_up*3
}