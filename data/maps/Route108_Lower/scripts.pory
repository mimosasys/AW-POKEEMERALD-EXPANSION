mapscripts Route108_Lower_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: Route108_Lower_Transition
}

script Route108_Lower_Transition {
    if (var(VAR_AW_PROGRESS_1) == 4) {
        lockall
        applymovement(OBJ_EVENT_ID_PLAYER,Player_LeaveLab)
        waitmovement(0)
        setobjectxy(3,8,8)
        applymovement(3,Carla_LeaveLab)
        waitmovement(0)
        message(format(
            "Fern: Well, {PLAYER}, this is Route 108.\p"
        ))
        waitmessage
        applymovement(2,LookRight)
        message(format(
            "To the east is Port Mulberry. It's the closest town to the lab.\p"
        ))
        waitmessage
        applymovement(2,LookDown)
        message(format(
            "And south of us is Puce City, and the nearby Puce Lake. It's an important dig site for us.\p"
        ))
        waitmessage
        applymovement(2,LookUp)
        message(format(
            "And, well, we're smack-bang in the middle!\p"
            "Say, have you caught a Pokémon before? This is as good a spot as any.\p"
            "Here, take these. I've got plenty spare.\p"
        ))
        waitmessage
        applymovement(2,WalkUp)
        waitmovement(0)
        giveitem(ITEM_POKE_BALL,10)
        playfanfare(MUS_OBTAIN_ITEM)
        message(format("Professor Fern gave you 10 pokéballs!\p"))
        waitfanfare
        waitmessage
        applymovement(2,LookDown)
        message(format(
            "Fern: Now, all you have to do is take step into that tall grass!\p"
            "It's best to lower the other Pokémon's health a fair bit before throwing a ball, but who knows, you might get lucky!\p"
        ))
        waitmessage
        applymovement(3,Carla_GoToPlayer)
        waitmovement(0)
        message(format(
            "Carla: You've got this! Go give it a shot! Catching Pokémon lets you make more friends!\p"
            "With the Pokémon, of course.\p"
        ))
        waitmessage
        applymovement(2,Professor_MoveToGrass)
        applymovement(3,Carla_MoveToGrass)
        waitmovement(0)
        applymovement(OBJ_EVENT_ID_PLAYER,Player_GoToGrass)
        waitmovement(0)
        setwildbattle(SPECIES_DEWSEL,3)
        dowildbattle
        specialvar(VAR_RESULT,GetBattleOutcome)
        applymovement(2,Carla_GoToPlayer2)
        applymovement(3,Professor_GoToPlayer)
        special(HealPlayerParty)
        if (var(VAR_RESULT) == B_OUTCOME_CAUGHT) {
            message(format(
                "Carla: Hey! Nice job, good catch!\p"
            ))
            waitmessage
        } elif (var(VAR_RESULT) == B_OUTCOME_WON) {
            message(format(
                "Carla: Oop, seems you were a bit enthusiastic.\pNevermind, you'll have plenty of other chances!\p"
            ))
            waitmessage
        } elif (var(VAR_RESULT) == B_OUTCOME_RAN) {
            message(format(
                "Carla: Aww, you were in with a chance! It's ok, though, we all have to run sometimes.\p"
            ))
            waitmessage
        } else {
            message(format(
                "Carla: Aww, dang! That's too bad. It's ok, we'll heal your Pokémon right up!\p"
            ))
            waitmessage
        }
        applymovement(OBJ_EVENT_ID_PLAYER,LookUp)
        delay(10)
        message(format(
            "Fern: Well, you get the picture.\p"
            "Actually, I have something to ask of you. I hope it's not too much all at once.\p"
        ))
        waitmessage
        message(format(
            "Carla: Oh, you mean...!\p"
            "That's a great idea!"
        ))
        waitmessage
        message(format(
            "Fern: You see, {PLAYER}, our research team is a bit...\p"
            "How do I put this...\p"
            "Short of staff at the moment. Really, it's just Carla, me, and a few other hands.\p"
            "So... I was thinking that while you're here recovering, you could help us out!\p"
        ))
        waitmessage
        msgbox(format("
            What do you say?
        "),MSGBOX_YESNO)
        if (var(VAR_RESULT) == 1) {
            closemessage
            applymovement(2,EmoteExclamation)
            delay(20)
            applymovement(2,LookUp)
            delay(20)
            applymovement(3,WalkLeftSpot)
            waitmovement(0)
            while (var(VAR_RESULT) == 0) {
                msgbox(format(
                    "Carla: Aw, please, {PLAYER}? We really do need a hand...\p"
                ),MSGBOX_YESNO)
            }
            waitmessage
        }
        closemessage
        applymovement(2,EmoteExclamation)
        delay(20)
        applymovement(2,LookDown)
        message(format(
            "Fern: ...! Oh! Well, thanks, {PLAYER}! It really will be such a big help for us!\p"
            "Carla: Soooo... I guess we'll leave you to get used to your surroundings.\p"
            "We're gonna go get ready for another expedition to Puce Lake, so come join us when you've had a look around.\p"
        ))
        waitmessage
        applymovement(3,Carla_BackToLab)
        applymovement(2,Professor_BackToLab)
        message(format(
            "Fern: See you round, {PLAYER}!\p"
        ))
        waitmessage
        applymovement(2,Professor_BackToLab2)
        message(format(
            "Carla: Catch lots of Pokémon! And be nice to yours, ok?\p"
        ))
        waitmessage
        applymovement(3,Carla_BackToLab2)
        waitmovement(0)
        removeobject(2)
        removeobject(3)
        setvar(VAR_AW_PROGRESS_1,5)
        setflag(FLAG_AW_FINISH_TUT)
        releaseall
    }
}

movement LookRight {
    face_right
}

movement LookDown {
    face_down
}

movement Player_LeaveLab {
    walk_down*2
}

movement Carla_LeaveLab {
    walk_down
    walk_right
    walk_down
    face_down
}

movement Professor_GiveBalls {
    walk_up*2
}

movement Carla_GoToPlayer {
    walk_down
    face_player
}

movement Professor_MoveToGrass {
    walk_down*2
    walk_left
    face_right
}

movement Carla_MoveToGrass {
    walk_down
    walk_left
    walk_down*4
    walk_left
    face_right
}

movement Player_GoToGrass {
    walk_down*7
}

movement Professor_GoToPlayer {
    walk_right
    walk_down*2
}

movement Carla_GoToPlayer2 {
    walk_fast_down*2
}

movement Carla_BackToLab {
    walk_up*3
    face_player
}

movement Professor_BackToLab {
    walk_up*2
    face_player
}

movement Professor_BackToLab2 {
    walk_up*6
}

movement Carla_BackToLab2 {
    walk_left
    walk_up*6
}