script PuceCity_Gym_Trainer1 {
    trainerbattle_single(TRAINER_LASS_TALIA,LassTaliaIntro,LassTaliaOutro)
    end
}

script PuceCity_Gym_Trainer2 {
    trainerbattle_single(TRAINER_SCHOOL_KID_CORAL,SchoolKidCoralIntro,SchoolKidCoralOutro)
    end
}

script PuceCity_Gym_Trainer3 {
    trainerbattle_single(TRAINER_SAILOR_MARINO,SailorMarinoIntro,SailorMarinoOutro)
    end
}

script PuceCity_Gym_Brooke {
    lockall
    msgbox(format(
        "Brooke: {PLAYER}! Nice job!\p"
        "Now there's just one thing left to do in the gym!\p"
        "I gotta say, you're gonna be the first gym challenger I've had.\p"
        "You ready? Gimme a good battle, won't'cha?"
    ))
    waitmessage
    closemessage
    trainerbattle_no_intro(TRAINER_GYMLEADER_BROOKE,LeaderBrookeOutro)
    msgbox(format(
        "Well, I can't say I'm all that surprised!\p"
        "That was some battle, alright, {PLAYER}. You sure have some skills!\p"
        "'n those Pokémon of yours are just amazing, too!\p"
        "Before I get started rambling, here's your badge! You've earned it!"
    ))
    waitmessage
    closemessage
    setflag(FLAG_BADGE01_GET)
    msgbox(format(
        "Obtained the Current Badge from Wendy!"
    ))
    playfanfare(MUS_OBTAIN_BADGE)
    waitfanfare
    waitmessage
    closemessage
    msgbox(format(
        "Nice! Keep that close, hey?\p"
        "Well, you've got a whole journey ahead of ya, and a whole region to explore!\p"
        "I did something like that when I was still studying, and now I'm a gym leader.\p"
        "Who knows where your journey will take you, eh?\p"
        "Just make sure to enjoy yourself, {PLAYER}. That's what's important.\p"
        "I'll see you around, ok? And thanks for the great battle!"
    ))
    waitmessage
    closemessage
    setvar(VAR_AW_PROGRESS_1,14)
    releaseall
}

text SchoolKidCoralIntro {
    format(
        "Hey! Welcome to the gym!\p"
        "Prepare to lose!"
    )
}

text SchoolKidCoralOutro {
    format(
        "I wasn't expecting that!"
    )
}

text LassTaliaIntro {
    format(
        "Think you've got the switches figured out?\p"
        "Then, what does this one control?"
    )
}

text LassTaliaOutro {
    format(
        "Blast! Got splashed!"
    )
}

text SailorMarinoIntro {
    format(
        "Not much longer now! Brooke's just over there!\p"
        "But it's not over yet!"
    )
}

text SailorMarinoOutro {
    format(
        "Woah!"
    )
}

text LeaderBrookeOutro {
    format(
        "I... I've sunk!"
    )
}

movement PuceCity_Gym_PlayerEnter {
    walk_up
    walk_right
    face_up
}

movement PuceCity_Gym_WendyWalkAway {
    walk_up*2
    jump_in_place_up*2
    jump_2_up
}