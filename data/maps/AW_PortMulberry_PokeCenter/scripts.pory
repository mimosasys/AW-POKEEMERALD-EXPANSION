mapscripts AW_PortMulberry_PokeCenter_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: PortMulberry_PokeCenter_OnTransition
    MAP_SCRIPT_ON_RESUME: CableClub_OnResume
}

script PortMulberry_PokeCenter_OnTransition {
    setrespawn(HEAL_LOCATION_AW_PORT_MULBERRY)
    end
}

script PortMulberry_PokeCenter_NPC1 {
    lockall
    faceplayer
    msgbox(format(
        "Ah! A young trainer!\p"
        "'ow lovely to see! It iz wonderful...\p"
        "I am Martine, a travelling chef from Kalos.\p"
        "A long way to travel, non?"
    ))
    waitmessage
    releaseall
}

script PortMulberry_PokeCenter_NPC2 {
    lockall
    faceplayer
    msgbox(format(
        "Woah! I didn't hear you coming, I was so engrossed in this book!\p"
        "What book is it?\p"
        "'House of Leavanny'.\p"
        "Ugh, it makes my head spin...\p"
        "But I can't stop reading!"
    ))
    waitmessage
    applymovement(3,LookUp)
    releaseall
}


script AW_CommonPokeCenter {
    lockall
    msgbox(format(
        "Hi, welcome to the Pokémon Center!\p"
        "Would you like us to heal your Pokémon?"
        ),MSGBOX_YESNO)
    waitmessage
    if(var(VAR_RESULT) == YES) {
        msgbox(format(
            "Sure, let me just take those from you..."
        ))
        delay(30)
        applymovement(1,WalkLeftSpot)
        waitmovement(0)
        incrementgamestat(GAME_STAT_USED_POKECENTER)
        special(HealPlayerParty)
        closemessage
        dofieldeffect(FLDEFF_POKECENTER_HEAL)
        waitfieldeffect(FLDEFF_POKECENTER_HEAL)
        applymovement(1,WalkDownSpot)
        msgbox(format(
            "There we are, all happy and healthy!"
        ))
        waitmessage
    }
    msgbox(format(
        "We hope to see you again!"
    ))
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER,LookDown)
    waitmovement(0)
    releaseall
}