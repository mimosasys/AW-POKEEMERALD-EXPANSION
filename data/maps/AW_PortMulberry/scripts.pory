mapscripts AW_PortMulberry_MapScripts {

}

script PortMulberry_LeaveLab {
    lockall
    pokenavcall(format(
        "Avery: {PLAYER}! That you? Looks like you got the PokéNav, then.\pGood job!\p"
        "You met Gear, then? They've been a \ngood friend of mine for years.\p"
        "Their knowledge in Pokémon DNA is unmatched. Though they do tend to\lbe a bit... anxious?\p"
        "Anyway, Carla and I are heading off\nto Puce Lake, just south of here.\pThere's already a few people there,\nand apparently we're onto something\lbig.\p"
        "Feel free to look around the place before coming around.\pI'll show you the ropes when\nyou get here, so to speak.\p"
        "Okay, {PLAYER}, see you soon!"
    ))
    waitmessage
    setvar(VAR_AW_PROGRESS_1,12)
    setflag(FLAG_AW_VISIT_MULBERRY)
    setflag(FLAG_AW_HIDE_CARLA_AVERY)
    setflag(FLAG_AW_HIDE_MIKE_1)
    setflag(FLAG_AW_HIDE_MIKE_2)
    setflag(FLAG_AW_HIDE_MIKE_3)
    releaseall
}