mapscripts AW_PuceLake_MapScripts {
    MAP_SCRIPT_ON_TRANSITION: PuceLake_MeetAvery_OnTransition
}

script PuceLake_MeetAvery_OnTransition {
    setflag(FLAG_AW_HIDE_MIKE_1)
    setflag(FLAG_AW_HIDE_MIKE_2)
    setflag(FLAG_AW_HIDE_MIKE_3)
    end
}

script PuceLake_MeetAvery {
    lockall

    setvar(VAR_0x8000,MUGSHOT_CARLA)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR BLUE}Carla:{COLOR DARK_GRAY} Hey, {PLAYER}! I knew you'd show up!"
        ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(4,PuceLake_CarlaGotoPlayer)
    applymovement(5,PuceLake_AveryGotoPlayer)
    waitmovement(5)
    
    setvar(VAR_0x8000,MUGSHOT_AVERY)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR GREEN}Fern:{COLOR DARK_GRAY} Gear's quite a character, aren't they? I'm glad they're safe.\p"
        "Accidentally turning themselves into a Pokemon? Can't say I've heard that one before.\p"
        "But I also can't say that's out of character for them.\p"
        "Well, this is Puce Lake. The lake itself is just around this path here, it's not far.\p"
        "It's quite a lovely place, actually. I come here to wind down after a hard day working!"
        ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(4,WalkUpSpot)
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_CARLA)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR BLUE}Carla:{COLOR DARK_GRAY} Avery, I haven't seen you leave the lab unless it's for an expedition.\p"
        "I wish you came here to wind down, you need it. You work yourself to the bone."
        ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(5,WalkDownSpot)
    waitmovement(0)

    delay(32)

    applymovement(4,WalkRightSpot)
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_CARLA)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR BLUE}Carla:{COLOR DARK_GRAY} ...You can tell he's really passionate about this, can't you?\p"
        "Um, we'll head on down to the lakeside. You'll see the dig site on the south side.\p"
        "I'll give you the tour once we're there! I hope you're excited to see it!\p"
        "Oh, and here's a little gift from Avery and I.\p"
        "I'm sure you'll find it useful. He helped make it himself, actually."
        ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(5,WalkRightSpot)
    waitmovement(0)
    playfanfare(MUS_OBTAIN_ITEM)

    msgbox(format(
        "Received the {COLOR RED}Pokédex{COLOR DARK_GRAY} from Professor Fern!"
    ))
    waitmessage

    waitfanfare
    setflag(FLAG_SYS_POKEDEX_GET)
	special(SetUnlockedPokedexFlags)
	setflag(FLAG_RECEIVED_POKEDEX_FROM_BIRCH)
    closemessage
    delay(15)
    applymovement(5,WalkRightSpot)
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_CARLA)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR BLUE}Carla:{COLOR DARK_GRAY} And here's a little something from me. It's nothing, really."
    ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    giveitem(ITEM_POTION,5)
    waitmessage
    closemessage

    delay(15)

    msgbox(format(
        "{COLOR GREEN}Fern:{COLOR DARK_GRAY} Er... yes. We'll get to it. See you in a bit, ok, {PLAYER}?"
        ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(4,PuceLake_CarlaLeavePlayer1)
    applymovement(5,PuceLake_AveryLeavePlayer)
    waitmovement(0)

    setflag(FLAG_AW_HIDE_PROFS_PUCE_LAKE)

    setvar(VAR_AW_PROGRESS_2,1)
    removeobject(4)
    removeobject(5)
    releaseall
    end
}

script PuceLake_TalkBrooke {
    lockall
    faceplayer
    msgbox(format(
        "Ain't the lake just so peaceful?\p"
        "Hm? Hey, you're a young trainer!\p"
        "The name's Brooke, 'n I'm the gym leader of Puce City.\p"
        "You wanna challenge the gym, hey?\p"
        "'nfortunately, I can't just let anyone fight me out of the blue like this.\p"
        "You've gotta be registered with the league first, ya see.\p"
        "And, well, I'm sorta new to this whole gym leader thing.\p"
        "Look, it's tempting to just get straight into it, I admit, but there's all sorts of regulations and things I gotta follow.\p"
        "If ya wanna get registered, head on over to the gym when I'm back.\p"
        "I'm just, uh, on my lunch break.\p"
        "Guess I'll see ya 'round?"
    ))
    waitmessage
    releaseall
}

script PuceLake_TalkCarla {
    lockall
    faceplayer
    setvar(VAR_0x8000,MUGSHOT_CARLA)
    callnative(DrawMugshot)
    msgbox(format(
        "Avery's just across there, at the dig site.\p"
        "Head over when you're ready!"
    ))
    waitmessage
    callnative(ClearMugshot)
    releaseall
}

script PuceLake_Trigger4_Left {
    setvar(VAR_TEMP_4,0)
    goto(PuceLake_GetToDigSite)
}

script PuceLake_Trigger4_Right {
    setvar(VAR_TEMP_4,1)
    goto(PuceLake_GetToDigSite)
}

script PuceLake_GetToDigSite {
    lockall
    applymovement(9,FacePlayer)
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_AVERY)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR GREEN}Fern:{COLOR DARK_GRAY} Well, here we are. This is our dig site."
    ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    special(SpawnCameraObject)
    applymovement(OBJ_EVENT_ID_CAMERA,Camera_LookDown3)
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_AVERY)
    callnative(DrawMugshot)
    msgbox(format(
        "We've managed to mark out the region of interest. Now we're into the important task of actually seeing what we've struck.\p"
        "You see, a kid from Puce City found a strange artefact on this very beach, and since we were close-by, he came to us.\p"
        "And, well, I was stunned. It looked hand-carved, but...\p"
        "As I'm sure you're aware, humans have only been in the --- Region for a few hundred years, because of how remote it is.\p"
        "So finding something as intricately designed as that? Dating back to as old as it was?\p"
        "Things like this are exactly why I came to --- in the first place, five years ago."
    ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(9,LookDown)
    waitmovement(0)
    
    setvar(VAR_0x8000,MUGSHOT_AVERY)
    callnative(DrawMugshot)
    msgbox(format(
        "I hate to say it, but our current dig team is a bit of a rag-tag group.\p"
        "We had to bring everyone together rather quickly.\p"
        "If I'm honest, this is the first dig we've had that I'm truly excited about.\p"
        "I've just got no idea what we'll find."
    ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    delay(15)

    applymovement(2,PuceLake_Scientist1)
    fadeoutbgm(1)
    waitmovement(0)

    msgbox(format(
        "Scientist: P-Professor...! I- I think I've found something of importance!"
    ))
    waitmessage
    closemessage

    applymovement(9,WalkDownSpot)
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_AVERY)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR GREEN}Fern:{COLOR DARK_GRAY} What is it?"
    ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(2,PuceLake_Scientist2)
    applymovement(15,PuceLake_AveryFollowScientist)
    applymovement(OBJ_EVENT_ID_PLAYER,PuceLake_PlayerFollowAvery1)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    special(RemoveCameraObject)
    if (var(VAR_TEMP_4) == 0) {
        applymovement(OBJ_EVENT_ID_PLAYER,PuceLake_PlayerFollowAvery2)
    }
    else {
        applymovement(OBJ_EVENT_ID_PLAYER,PuceLake_PlayerFollowAvery3)
    }
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_AVERY)
    callnative(DrawMugshot)
    msgbox(format(
        "Scientist: ...Do you see it?\p"
        "The... the carving...!"
    ))
    waitmessage
    closemessage

    applymovement(9,EmoteQuestion)
    waitmovement(0)
    delay(60)
    applymovement(9,EmoteExclamation)
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_AVERY)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR GREEN}Fern:{COLOR DARK_GRAY} ...Oh my goodness.\p"
        "It... it's some sort of language. It has to be.\p"
        "The stone is... it's painted...!\p"
        "Terry, this is a major discovery!\p"
        "We have to get to work bringing this back to the lab!"
    ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    applymovement(2,WalkRightSpot)
    waitmovement(0)
    
    msgbox(format(
        "Scientist: Y-yes! Of course!"
    ))
    waitmessage
    closemessage

    applymovement(9,PuceLake_AveryGotoPlayer2)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER,FaceRight)
    waitmovement(0)

    setvar(VAR_0x8000,MUGSHOT_AVERY)
    callnative(DrawMugshot)
    msgbox(format(
        "{COLOR GREEN}Fern:{COLOR DARK_GRAY} {PLAYER}, sorry, this is a bit bigger than I was expecting.\p"
        "I was going to get you to help out with tagging things, just to start you off...\p"
        "But this has gotten way out of hand. I'm gonna have to ask you to let the professionals handle this one.\p"
        "A bit of a let down, I know, but just think!\p"
        "What have we just discovered? What secrets will we unearth?\p"
        "I'll uh... I'll call you when this is all sorted out.\p"
        "For now, just relax. We'll take care of this."
    ))
    waitmessage
    closemessage
    callnative(ClearMugshot)

    fadescreen(FADE_TO_BLACK)
    delay(60)

    applymovement(OBJ_EVENT_ID_PLAYER,PuceLake_PlayerGotoLeave)

    //formatwarp(MAP_AW_PUCE_LAKE,31,23)

    setflag(FLAG_AW_HIDE_PROFS_PUCE_LAKE2)
    setmetatile(21,35,0x071,FALSE)
    waitmovement(0)
    fadescreen(FADE_FROM_BLACK)
    fadeinbgm(1)
    applymovement(OBJ_EVENT_ID_PLAYER,PuceLake_PlayerLeave)
    waitmovement(0)
    applymovement(10,PuceLake_BrookeGotoPlayer)
    waitmovement(0)

    msgbox(format(
        "Brooke: Hey! I, uh...\p"
        "I saw you battling those trainers back there.\p"
        "You've got some guts, you know?\p"
        "If you want another challenge, head on over to my gym.\p"
        "I'll get you set up with the league registry and everything!\p"
        "Looks like my lunch break is over, so hopefully I'll see you there!"
    ))
    waitmessage
    closemessage

    applymovement(16,PuceLake_BrookeLeave)
    //setflag(FLAG_GYM_)
    setvar(VAR_AW_PROGRESS_2,2)
    setvar(VAR_AW_GYM_PROGRESS,1)
    setvar(VAR_AW_PROGRESS_1,13)
    waitmovement(0)
    setobjectxyperm(10,0,0)
    removeobject(10)

    releaseall
}

script PuceLake_DigSiteSign {
    lockall
    msgbox(format(
        "- TEAM TOPAZ DIG SITE -\nAuthorized Persons Only\p"
    ),MSGBOX_SIGN)
    waitmessage
    releaseall
}

script PuceLake_Trigger1_Upper {
    setvar(VAR_TEMP_0,0)
    call(PuceLake_MeetAvery)
    end
}

script PuceLake_Trigger1_Lower {
    setvar(VAR_TEMP_0,1)
    call(PuceLake_MeetAvery)
    end
}

script PuceLake_Trainer_SchoolgirlJessy {
    trainerbattle_single(TRAINER_SCHOOLKIDF_JESSY,SchoolgirlJessyIntro,SchoolgirlJessyOutro)
    end
}

script PuceLake_Trainer_YoungsterTyler {
    trainerbattle_single(TRAINER_YOUNGSTER_TYLER,YoungsterTylerIntro,YoungsterTylerOutro)
    end
}

script PuceLake_Trainer_LassAdela {
    trainerbattle_single(TRAINER_LASS_ADELA,LassAdelaIntro,LassAdelaOutro)
    end
}

text SchoolgirlJessyIntro {
    format(
        "Um... hi! It's my first battle, so go easy on me!"
    )
}

text SchoolgirlJessyOutro {
    format(
        "That was your first battle, too? So cool!"
    )
}

text YoungsterTylerIntro {
    format(
        "Hey! You got Pokémon? Let's battle! I'll win!"
    )
}

text YoungsterTylerOutro {
    format(
        "Aw, you're good..."
    )
}

text LassAdelaIntro {
    format(
        "The lakeside is so calming... Gah! A trainer!"
    )
}

text LassAdelaOutro {
    format(
        "Sigh, back to enjoying the view..."
    )
}

movement PuceLake_CarlaGotoPlayer {
    walk_up*6
    face_right
}

movement PuceLake_AveryGotoPlayer {
    walk_up*7
    walk_right
}

movement WalkDownSpot {
    walk_in_place_down*2
}

movement PuceLake_AveryLeavePlayer {
    walk_left
    walk_down*7
}

movement PuceLake_CarlaLeavePlayer1 {
    face_left
    walk_down*6
}

movement PuceLake_MikeGotoPlayer {
    walk_slow_left*2
    walk_left*2
}

movement PuceLake_MikeGotoPlayer2 {
    walk_fast_down
    walk_fast_left*3
}

movement PuceLake_MikeGotoPlayer3 {
    walk_fast_down*2
    walk_fast_left*3
}

movement PuceLake_MikeGotoPlayer4 {
    walk_down*3
    walk_left*2
    walk_down
    walk_left
    walk_down
}

movement PuceLake_MikeGotoPlayer5 {
    walk_left
    face_down
}

movement PuceLake_MikeGotoPlayer6 {
    walk_down
}

movement PuceLake_MikeGotoPlayer7 {
    walk_down*3
    walk_left
    walk_down*3
}

movement PuceLake_MikeGotoPlayer8 {
    walk_down
    walk_left*2
}

movement PuceLake_MikeGotoPlayer9 {
    walk_left*2
}

