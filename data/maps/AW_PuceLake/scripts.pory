mapscripts AW_PuceLake_MapScripts {

}

script PuceLake_MeetAvery {
    lockall
    setvar(VAR_AW_PROGRESS_2,1)
    msgbox(format(
        "Carla: Hey, {PLAYER}! I knew you'd show up!"
        ))
    waitmessage
    closemessage
    applymovement(4,PuceLake_CarlaGotoPlayer)
    applymovement(5,PuceLake_AveryGotoPlayer)
    waitmovement(5)
    msgbox(format(
        "Avery: Gear's quite a character, aren't they? I'm glad they're safe.\p"
        "Well, this is Puce Lake. The lake itself is just around this path here, it's not far.\p"
        "It's quite a lovely place, actually. I come here to wind down after a hard day working!"
        ))
    waitmessage
    applymovement(4,WalkUpSpot)
    waitmovement(0)
    msgbox(format(
        "Carla: Avery, I haven't seen you leave the lab unless it's for an expedition.\p"
        "I wish you came here to wind down, you need it. You work yourself to the bone."
        ))
    waitmessage
    applymovement(5,WalkDownSpot)
    waitmovement(0)
    msgbox(format(
        "Avery: It's important research, Carla. And besides, I can't just leave the lab unattended.\p"
        "Not with Team Jade about. They'll try steal our research again."
        ))
    waitmessage
    applymovement(4,FaceRight)
    applymovement(5,FaceRight)
    msgbox(format(
        "Avery: Haven't heard of them, {PLAYER}? They're a fellow archaeology group that, instead of doing their own research, seem intent on stealing mine.\p"
        "They've been around for a few years, and they've had a few successes, too.\p"
        "It's really set us back a lot. That's part of the reason we're so short-staffed. So many of them have just... given up, really.\p"
        "But I'm not giving up. I don't care if we have funding or not. I'm going to uncover the history of this region."
        ))
    waitmessage
    applymovement(4,WalkRightSpot)
    waitmovement(0)
    msgbox(format(
        "Carla: ...You can tell he's really passionate about this, can't you?\p"
        "Um, we'll head on down to the lakeside. You'll see the dig site on the south side.\p"
        "I'll give you the tour once we're there! I hope you're excited to see it!"
        ))
    waitmessage
    applymovement(5,WalkRightSpot)
    waitmovement(0)
    msgbox(format(
        "Avery: Er... yes. We'll get to it. See you in a bit, ok, {PLAYER}?"
        ))
    waitmessage
    applymovement(4,PuceLake_CarlaLeavePlayer1)
    applymovement(5,PuceLake_AveryLeavePlayer)
    waitmovement(5)
    applymovement(4,FaceRight)
    waitmovement(0)
    msgbox(format(
        "Carla: Uh, I don't mean to alarm you, but..."
        ))
    waitmessage
    fadeoutbgm(1)
    msgbox(format(    
        "There's a boy behind you who's been staring at you this whole time.\p"
        "Do you know him?"
        ))
    waitmessage
    closemessage
    applymovement(4,PuceLake_CarlaLeavePlayer2)
    waitmovement(0)

    special(SpawnCameraObject)
    clearflag(FLAG_AW_HIDE_MIKE_1)
    applymovement(6,FaceLeft)
    applymovement(OBJ_EVENT_ID_PLAYER,FaceRight)
    applymovement(OBJ_EVENT_ID_CAMERA,Camera_LookRight3)
    waitmovement(0)
    msgbox(format(
        "Mike: ...{PLAYER}?"
        ))
    waitmessage
    closemessage
    applymovement(6,PuceLake_MikeGotoPlayer)
    waitmovement(0)
    if (var(VAR_TEMP_0) == 0) {
        applymovement(6,PuceLake_MikeGotoPlayer2)
    } else {
        applymovement(6,PuceLake_MikeGotoPlayer3)
    }
    applymovement(OBJ_EVENT_ID_CAMERA,Camera_LookLeft3)
    waitmovement(0)
    special(RemoveCameraObject)
    msgbox(format(
        "Mike: {PLAYER}! O-oh my goodness! I- I thought- I thought you'd...\p"
        "I- I'm so glad you're alright!\p"
        "I thought I was going to die... and then this Pokémon swooped out of nowhere and saved me!\p"
        "When I woke up, I was in some laboratory, and this guy -\p"
        "Professor Conifer, that's his name -\p"
        "He made sure I was ok...\p"
        "I- I mean, I'm still a bit bruised, but..."
        ))
    waitmessage
    closemessage
    applymovement(6,EmoteExclamationMark)
    waitmovement(0)
    msgbox(format(
        "N- no way! That's what happened to you, too?!\p"
        "..."
        ))
    waitmessage
    closemessage
    applymovement(6,LookDown)
    waitmovement(0)
    msgbox(format(
        "That must have been him, then..."
    ))
    waitmessage
    fadeinbgm(1)
    closemessage
    applymovement(6,FaceLeft)
    waitmovement(0)
    msgbox(format(
        "U- uh... Anyway!\p"
        "Let's walk together, ok? Take in the lakeside air!"
    ))
    waitmessage
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER,WalkLeft1)
    applymovement(6,WalkLeft1)
    waitmovement(0)
    msgbox(format(
        "Ow, on second thoughts, you go on ahead. My legs are still hurting...\p"
        "I'll catch up, ok?"
    ))
    waitmessage

    setobjectxyperm(4,33,23)
    setobjectxyperm(5,30,23)
    releaseall
    end
}

script PuceLake_MikeTalk {
    setvar(VAR_AW_PROGRESS_2,1)
    removeobject(6,MAP_AW_PUCE_LAKE)
    setflag(FLAG_AW_HIDE_MIKE_1)
    clearflag(FLAG_AW_HIDE_MIKE_2)
    setobjectxyperm(10,56,24)
    showobjectat(10,MAP_AW_PUCE_LAKE)

    lockall
    applymovement(10,PuceLake_MikeGotoPlayer4)
    waitmovement(0)
    if (var(VAR_TEMP_2)==0) {
        applymovement(10,PuceLake_MikeGotoPlayer5)
        waitmovement(0)
        applymovement(OBJ_EVENT_ID_PLAYER,LookUp)
    } else {
        applymovement(10,PuceLake_MikeGotoPlayer6)
        waitmovement(0)
        applymovement(OBJ_EVENT_ID_PLAYER,LookUp)
    }
    msgbox(format(
        "Mike: Phew! Made it!\p"
        "Gah... now my legs hurt again... I'm gonna rest for a bit...\p"
        "Wanna talk?\p"
        "I uh... When I got saved by that professor, he told me some things.\p"
        "He said that there's this other professor named Fern, and they're enemies.\p"
        "That's... that's the professor that saved you, isn't it?\p"
        "Just um... be careful around him, ok?\p"
        "Milo - that's Professor Conifer - doesn't trust him, and he told me not to either.\p"
        "He sounds pretty shady... he said they used to be close, but...\p"
        "They haven't talked in years, and now they're enemies.\p"
        "I wonder what happened between them?\p"
        "...\p"
        "You keep going ahead, ok?\p"
        "My legs still need a bit more time, hah..."
    ))    
    waitmessage
    releaseall
    end
}

script PuceLake_MeetCarla {
    setvar(VAR_AW_PROGRESS_2,2)
    setflag(FLAG_AW_HIDE_MIKE_2)
    clearflag(FLAG_AW_HIDE_MIKE_3)
    showobjectat(11,MAP_AW_PUCE_LAKE)
    showobjectat(12,MAP_AW_PUCE_LAKE)
    showobjectat(13,MAP_AW_PUCE_LAKE)

    lockall
    applymovement(4,WalkRightSpot)
    waitmovement(0)
    msgbox(format(
        "Carla: Ah, there you are, {PLAYER}! How was the walk?\p"
        "Let me heal up that team of yours!"
    ))
    waitmessage
    closemessage
    special(HealPlayerParty)
    applymovement(OBJ_EVENT_ID_PLAYER,WalkLeftSpot)
    msgbox(format(
        "Who was that guy, by the way?\p"
        "Oh, a friend of yours? Neat!\p"
        "Looks like he's caught up with you. I'll say hi!"
    ))
    waitmessage
    closemessage
    
    applymovement(11,PuceLake_MikeGotoPlayer7)
    waitmovement(0)
    if (var(VAR_TEMP_3)==0) {
        applymovement(11,PuceLake_MikeGotoPlayer8)
        waitmovement(0)
    } else {
        applymovement(11,PuceLake_MikeGotoPlayer9)
        waitmovement(0)
    }

    msgbox(format(
        "Carla: Hi! You must be {PLAYER}'s friend, right?"
    ))
    waitmessage
    closemessage
    applymovement(11,WalkLeftSpot)
    waitmovement(0)

    msgbox(format(
        "Mike: H-hi ma'am... Y-yes, that's right.\p"
        "Carla: Oh, don't be so formal, it's alright!"
        "I'm the assistant to Professor Avery Fern. He's an archaeologist from around here.\p"
        "Mike: Y-you're -\p"
        "Carla: And {PLAYER} here is helping out too! Avery asked her to help out with this dig site! Ain't that exciting?"
    ))
    waitmessage
    closemessage
    fadeoutbgm(1)
    delay(30)
    applymovement(11,LookUp)
    delay(30)
    msgbox(format(
        "Mike: {PLAYER}...? Y-you're helping him?\p"
        "He's shady! No good! That's what Conifer told me!\p"
        "I... What do I do?!"
    ))
    waitmessage
    playbgm(MUS_ENCOUNTER_AQUA,FALSE)
    applymovement(12,PuceLake_Grunt1Enter)
    applymovement(13,PuceLake_Grunt1Enter)
    waitmovement(13)
    msgbox(format(
        "Jade Grunt 1: Ha-HA! Knew we'd find you lot here.\p"
        "Finding another important site, taking the contents for yourself...\p"
        "Jade Grunt 2: We simply won't let you! This site belongs to Team Jade!"
    ))
    waitmessage
    applymovement(11,WalkRightSpot)
    waitmovement(0)
    msgbox(format(
        "Mike: You guys..! You came!\p"
        "Grunt 1: Yes, yes, we heard, Mikey.\p"
        "Carla: Team Jade! How did I know you guys would show up?\p"
        "{PLAYER}, it seems your friend here is with those Jade guys. That's not good for us.\p"
        "Grunt 1: Listen here - what do you do with people standing in your way?\p"
        "Mike: ...?\p"
        "Grunt 2: You challenge them to a battle! The prof did give you a Pokémon, right?\p"
        "Mike: Y-yeah!\p"
        "Grunt 1: We'll deal with the assistant, you deal with the kid. Got it?\p"
        "Mike: I... ok..!"
    ))
    waitmessage
    applymovement(11,FacePlayer)
    waitmovement(0)
    msgbox(format(
        "Mike: {PLAYER}, I...\p"
        "I challenge you to a battle!"
    ))
    waitmessage
    closemessage
    if (flag(FLAG_AW_PICK_ALPACOIL)) {
        trainerbattle_no_intro(TRAINER_RIVAL_PUCELAKE_ALPACOIL,PuceLake_MikeLose)
    } elif (flag(FLAG_AW_PICK_SMACKOP)) {
        trainerbattle_no_intro(TRAINER_RIVAL_PUCELAKE_SMACKOP,PuceLake_MikeLose)
    } else {
        trainerbattle_no_intro(TRAINER_RIVAL_PUCELAKE_PUPPIXY,PuceLake_MikeLose)
    }

    setvar(VAR_AW_PROGRESS_1,9)

    releaseall
    end
}

script PuceLake_DontLeaveYet1 {
    lockall
    applymovement(6,WalkLeftSpot)
    waitmovement(0)
    msgbox(format(
        "Mike: {PLAYER}? Come on, you go ahead.\p"
        "...My legs just hurt, that's all. I'll catch up."
    ))
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER,WalkLeft1)
    waitmovement(0)
    releaseall
}

script PuceLake_DontLeaveYet2 {
    lockall
    applymovement(10,WalkLeftSpot)
    waitmovement(0)
    msgbox(format(
        "Mike: I'm alright, {PLAYER}, don't worry.\p"
        "I'll catch up!"
    ))
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER,WalkLeft1)
    waitmovement(0)
    releaseall
}

script PuceLake_Trigger1_Upper {
    setvar(VAR_TEMP_0,0)
    call_if_eq(VAR_AW_PROGRESS_2,0,PuceLake_MeetAvery)
    call(PuceLake_DontLeaveYet1)
    end
}

script PuceLake_Trigger1_Lower {
    setvar(VAR_TEMP_0,1)
    
    call_if_eq(VAR_AW_PROGRESS_2,0,PuceLake_MeetAvery)
    call(PuceLake_DontLeaveYet1)
    end
}

script PuceLake_Trigger2_Upper {
    setvar(VAR_TEMP_2,0)
    call_if_eq(VAR_AW_PROGRESS_2,1,PuceLake_MikeTalk)
    call(PuceLake_DontLeaveYet2)
    end   
}

script PuceLake_Trigger2_Lower {
    setvar(VAR_TEMP_2,1)
    call_if_eq(VAR_AW_PROGRESS_2,1,PuceLake_MikeTalk)
    call(PuceLake_DontLeaveYet2)
    end  
}

script PuceLake_Trigger3_Upper {
    setvar(VAR_TEMP_3,0)
    call(PuceLake_MeetCarla)
}

script PuceLake_Trigger3_Lower {
    setvar(VAR_TEMP_3,1)
    call(PuceLake_MeetCarla)
}

script PuceLake_Trainer_SchoolgirlJessy {
    trainerbattle_single(TRAINER_JESSY,SchoolgirlJessyIntro,SchoolgirlJessyOutro)
    end
}

script PuceLake_Trainer_YoungsterTyler {
    trainerbattle_single(TRAINER_TYLER,YoungsterTylerIntro,YoungsterTylerOutro)
    end
}

script PuceLake_Trainer_LassAdela {
    trainerbattle_single(TRAINER_ADELA,LassAdelaIntro,LassAdelaOutro)
    end
}

text SchoolgirlJessyIntro {
    format(
        "Um... hi! It's my first battle, so go easy on me!"
    )
}

text SchoolgirlJessyOutro {
    format(
        "That was your first battle, too? So cool!"
    )
}

text YoungsterTylerIntro {
    format(
        "Hey! You got Pokémon? Let's battle! I'll win!"
    )
}

text YoungsterTylerOutro {
    format(
        "Aw, you're good..."
    )
}

text LassAdelaIntro {
    format(
        "The lakeside is so calming... Gah! A trainer!"
    )
}

text LassAdelaOutro {
    format(
        "Sigh, back to enjoying the view..."
    )
}

text PuceLake_MikeLose {
    format(
        "{PLAYER}...!"
    )
}

movement PuceLake_CarlaGotoPlayer {
    walk_up*6
    face_right
}

movement PuceLake_AveryGotoPlayer {
    walk_up*7
    walk_right
}

movement WalkDownSpot {
    walk_in_place_down*2
}

movement PuceLake_AveryLeavePlayer {
    walk_left
    walk_down*7
}

movement PuceLake_CarlaLeavePlayer1 {
    face_left
}

movement PuceLake_CarlaLeavePlayer2 {
    walk_down*6
}

movement PuceLake_MikeGotoPlayer {
    walk_slow_left*2
    walk_left*2
}

movement PuceLake_MikeGotoPlayer2 {
    walk_fast_down
    walk_fast_left*3
}

movement PuceLake_MikeGotoPlayer3 {
    walk_fast_down*2
    walk_fast_left*3
}

movement PuceLake_MikeGotoPlayer4 {
    walk_down*3
    walk_left*2
    walk_down
    walk_left
    walk_down
}

movement PuceLake_MikeGotoPlayer5 {
    walk_left
    face_down
}

movement PuceLake_MikeGotoPlayer6 {
    walk_down
}

movement PuceLake_MikeGotoPlayer7 {
    walk_down*3
    walk_left
    walk_down*3
}

movement PuceLake_MikeGotoPlayer8 {
    walk_down
    walk_left*2
}

movement PuceLake_MikeGotoPlayer9 {
    walk_left*2
}

movement PuceLake_Grunt1Enter {
    walk_fast_down*7
    walk_fast_left
}

movement PuceLake_Grunt2Enter {
    walk_fast_down*4
    walk_fast_left
    walk_fast_down*4
    walk_fast_left
}

movement FaceLeft {
    face_left
}

movement WalkLeft1 {
    walk_left
}