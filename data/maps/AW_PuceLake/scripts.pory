}

movement PuceLake_Scientist1 {
    emote_question_mark
    delay_16
    delay_16
    delay_16
    delay_16
    emote_exclamation_mark
    delay_16
    delay_16
    delay_16
    delay_16
    walk_in_place_slow_right*3
    walk_fast_up
    walk_fast_right
    walk_fast_up*2
    walk_in_place_fast_up*3
}

movement PuceLake_Scientist2 {
    walk_fast_down*2
    walk_fast_left
    walk_fast_down
    face_right
}

movement PuceLake_AveryFollowScientist {
    walk_down*3
    walk_right
    walk_down
    face_left
}

movement PuceLake_PlayerFollowAvery1 {
    walk_down*3
}

movement PuceLake_PlayerFollowAvery2 {
    walk_right
    walk_down*2

}

movement PuceLake_PlayerFollowAvery3 {
    walk_down*2

}

movement PuceLake_AveryGotoPlayer2 {
    walk_fast_up
    face_player
}

movement PuceLake_PlayerGotoLeave {
    walk_faster_up*6
    walk_faster_right*6
    walk_faster_up*5
    walk_faster_right*4
}

movement PuceLake_PlayerLeave {
    walk_right*4
    walk_up
    walk_right*2
    walk_up*6
}

