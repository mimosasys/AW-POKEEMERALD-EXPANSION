mapscripts AW_Route108_Laboratory_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_AW_PROGRESS_1, 2: Route108_Laboratory_OnWarp
    ]
}

script Route108_Laboratory_OnWarp {
    fadeoutbgm(1)
    setvar(VAR_AW_PROGRESS_1,3)
    setrespawn(HEAL_LOCATION_AW_ROUTE108)
    call(Route108_Laboratory_FirstTime)
}

script Route108_Laboratory_FirstTime {
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER,Player_GetUp)
    applymovement(1,EmoteExclamation)
    waitmessage
    message(format(
        "???: Professor! Professor! They're awake.\p"
        ))
    waitmessage
    closemessage
    delay(20)
    playbgm(AW_MUS_LABORATORY,FALSE)
    applymovement(2,Route108_ProfessorEnter)
    waitmovement(0)
    message(format(
        "???: Oh, I'm so glad you're alright.\p"
        "You fell from up on Mt. Eigo. How'd you even get up there, anyway?\p"
        ))
    waitmessage
    delay(40)
    applymovement(2,EmoteExclamation)
    delay(10)
    message(format(
        "Y- you say you live up there?! That can't be right! Nobody lives up there!\p"
    ))
    waitmessage
    applymovement(1,WalkLeftSpot)
    waitmovement(0)
    message(format(
        "???: Professor....\p"
    ))
    waitmessage
    closemessage
    delay(30)
    applymovement(2,LookDown)
    delay(80)
    message(format(
        "???: Hmm... Well, I've been wrong before...\p"
    ))
    waitmessage
    closemessage
    delay(80)
    applymovement(2,FacePlayer)
    message(format(
        "A- anyway..! I suppose I should introduce myself.\p"
        "My name is Avery Fern. I'm a professor of archaeology, and this is my lab.\p"
    ))
    waitmessage
    delay(30)
    applymovement(2,LookUp)
    waitmovement(0)
    delay(10)
    message(format(
        "And this is my assistant, Carla.\p"
    ))
    waitmessage
    applymovement(1,WalkRightSpot)
    waitmovement(0)
    message(format(
        "Carla: Hi!\p"
    ))
    waitmessage
    delay(10)
    applymovement(2,FacePlayer)
    message(format(
        "Fern: And you are?\p"
    ))
    waitmessage
    closemessage
    delay(60)
    message(format(
        "Fern: Ah, {PLAYER}. Well, you are something of an enigma, that's for sure. It's lovely to make your acquaintaince.\p"
        "I think you should stay here a while, just to make sure you recover properly.\pVibrava caught you, but I can't say whether or not you were hurt on the way down.\p"
    ))
    waitmessage
    delay(10)
    applymovement(1,LookLeft)
    waitmovement(0)
    message(format(
        "Carla: Yeah. Hey, we should show {PLAYER} around the lab!\p"
    ))
    waitmessage
    applymovement(2,FacePlayer)
    message(format(
        "Fern: You don't have a Pokémon, do you? We should probably do something about that.\p"
        "Here, come with me.\p"
    ))
    waitmessage
    closemessage
    applymovement(2,ProfessorToPokeballs)
    applymovement(1,CarlaToPokeballs)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER,PlayerToPokeballs)
    waitmovement(0)
    message(format(
        "Fern: Sorry, it's a bit of a mess. Here they are!\pTake your pick.\p"
    ))
    waitmessage
    releaseall
}

script Route108_Laboratory_DontLeaveLeft {
    lock
    applymovement(1,WalkLeftSpot)
    waitmovement(0)
    delay(20)
    message(format(
        "Carla: Go on, choose one!\p"
    ))
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER,Player_WalkLeft)
    waitmovement(0)
    release
}

script Route108_Laboratory_DontLeaveRight {
    lock
    applymovement(1,WalkLeftSpot)
    waitmovement(0)
    delay(20)
    message(format(
        "Carla: Go on! Choose one!\p"
    ))
    waitmessage
    applymovement(OBJ_EVENT_ID_PLAYER,Player_WalkUp)
    waitmovement(0)
    release
}

movement Player_GetUp {
    walk_in_place_slow_up
    walk_in_place_slow_down
    face_left
}

script Route108_Laboratory_PickAlpacoil {
    lock
    if (var(VAR_AW_PROGRESS_1) == 3) {
        showmonpic(SPECIES_ALPACOIL,10,3)
        msgbox(format(
            "This is Alpacoil, the Steel Wool Pokémon!\p"
            "Would you like to take Alpacoil?\p"
        ), MSGBOX_YESNO)
        if (var(VAR_RESULT) == 1) {
            playmoncry(SPECIES_ALPACOIL,CRY_MODE_NORMAL)
            givemon(SPECIES_ALPACOIL,5)
            setflag(FLAG_SYS_POKEMON_GET)
            waitmoncry
            playfanfare(MUS_OBTAIN_ITEM)
            waitfanfare
            removeobject(3)
            setflag(FLAG_AW_PICK_ALPACOIL)
            call(Route108_Laboratory_Yay)
        } else {
            hidemonpic
            release
        }
    } else {
        message(format("It's one of the Professor's Pokémon.\p"))
        waitmessage
        release
    }
}

