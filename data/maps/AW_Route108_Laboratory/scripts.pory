script Route108_Laboratory_Yay {
    setflag(FLAG_AW_MID_TUT)
    msgbox(format(
        "Would you like to give your Pokémon a nickname?\p"
    ), MSGBOX_YESNO)
    if (var(VAR_RESULT) == 1) {
        call(Common_EventScript_NameReceivedPartyMon)
    }
    closemessage
    hidemonpic
    setvar(VAR_AW_PROGRESS_1,4)
    message(format(
        "Fern: Well, that's that.\p"
    ))
    waitmessage
    applymovement(1,WalkUpSpot)
    waitmovement(0)
    message(format(
        "Carla: And what a cute Pokémon you chose!\p"
    ))
    waitmessage
    message(format(
        "Fern: Ok, now! Follow me outside, I'll show you around the place.\p"
    ))
    waitmessage
    closemessage
    applymovement(2,ProfessorLeave)
    waitmovement(0)
    playse(SE_DOOR)
    removeobject(2)
    delay(60)
    release
    hideobjectat(3,MAP_AW_ROUTE108_LOWER)
}

script Route108_Laboratory_TalkCarla {
    lock
    applymovement(1,FacePlayer)
    if (var(VAR_AW_PROGRESS_1) == 3) {
        message(format(
            "Carla: Go on! Make a choice! They're all wonderful creatures.\p"
        ))
        waitmessage
    } else {
        if (var(VAR_AW_PROGRESS_1) == 4) {
            message(format(
                "Carla: Go on, Professor Fern is waiting for you! Let's go.\p"
            ))
            waitmessage
        } else {
            message(format(
                "Carla: What's up, {PLAYER}? I'm just doing my research, as usual.\p"
            ))
            waitmessage
        }
    }
    release
}

script Route108_Laboratory_HealMachine {
    lockall
    fadescreen(FADE_TO_BLACK)
    waitstate
    setrespawn(HEAL_LOCATION_AW_ROUTE108)
    special(HealPlayerParty)
    playfanfare(MUS_HEAL)
    waitfanfare
    fadescreen(FADE_FROM_BLACK)
    waitstate
    releaseall
}

movement Route108_ProfessorEnter {
    walk_down
    walk_left*5
    walk_down*5
    walk_right*4
    face_right
}

movement WalkLeftSpot {
    walk_in_place_left*2
}

movement WalkRightSpot {
    walk_in_place_right*2
}

movement LookUp {
    face_up
}

movement LookLeft {
    face_left
}

movement ProfessorToPokeballs {
    walk_left*5
    walk_down*6
    walk_left*11
    face_up
}

movement CarlaToPokeballs {
    walk_left*4
    walk_down
    walk_left*2
    walk_down*7
    walk_left*10
}

movement PlayerToPokeballs {
    walk_left*1
    walk_down*1
    walk_left*7
    walk_down*5
    walk_left*10
}

movement Player_WalkLeft {
    walk_left
}

movement ProfessorLeave {
    walk_down*2
}